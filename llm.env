# ==============================================================================
# UNIVERSAL LLM CONFIGURATION
# Switch providers anytime by editing these values—no Python code changes needed.
# ==============================================================================

# --- OPTION 1: OpenRouter Free Tier (Default - Globally Accessible) ---
LLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai

# --- OPTION 2: Mistral AI Free Tier ("La Plateforme") ---
# LLM_MODEL=mistral/mistral-small-latest
# LLM_API_KEY=your_mistral_api_key_here
# LLM_BASE_URL=https://mistral.ai

# --- OPTION 3: Local Ollama (100% Offline, Zero Limits) ---
# LLM_MODEL=ollama/qwen2.5:14b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434

# ==============================================================================
# EXECUTION & RATE-LIMIT CONTROLS
# ==============================================================================
LLM_TEMPERATURE=0.2
LLM_MAX_RPM=12
CREW_VERBOSE=true
